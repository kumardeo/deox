{
  "name": "@deox/utils",
  "version": "0.1.0",
  "description": "Utilities",
  "keywords": [
    "utils"
  ],
  "license": "MIT",
  "author": {
    "name": "Deo Kumar",
    "url": "https://github.com/kumardeo"
  },
  "homepage": "https://github.com/kumardeo/deox/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumardeo/deox",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/kumardeo/deox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome lint ./src",
    "check": "biome check ./src",
    "check:types": "tsc --noEmit",
    "build": "NODE_ENV=production tsdown",
    "dev": "NODE_ENV=development tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abbreviate-number": {
      "types": "./dist/abbreviate-number.d.ts",
      "default": "./dist/abbreviate-number.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "default": "./dist/base64.js"
    },
    "./cookie": {
      "types": "./dist/cookie.d.ts",
      "default": "./dist/cookie.js"
    },
    "./copy-text": {
      "types": "./dist/copy-text.d.ts",
      "default": "./dist/copy-text.js"
    },
    "./create-element": {
      "types": "./dist/create-element.d.ts",
      "default": "./dist/create-element.js"
    },
    "./deferred-promise": {
      "types": "./dist/deferred-promise.d.ts",
      "default": "./dist/deferred-promise.js"
    },
    "./generate-id": {
      "types": "./dist/generate-id.d.ts",
      "default": "./dist/generate-id.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "default": "./dist/lazy.js"
    },
    "./params": {
      "types": "./dist/params.d.ts",
      "default": "./dist/params.js"
    },
    "./predicate": {
      "types": "./dist/predicate.d.ts",
      "default": "./dist/predicate.js"
    },
    "./pretty-bytes": {
      "types": "./dist/pretty-bytes.d.ts",
      "default": "./dist/pretty-bytes.js"
    },
    "./shade-blend-color": {
      "types": "./dist/shade-blend-color.d.ts",
      "default": "./dist/shade-blend-color.js"
    }
  },
  "dependencies": {
    "shade-blend-color": "^1.0.0"
  },
  "devDependencies": {
    "@types/shade-blend-color": "^1.0.3",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
