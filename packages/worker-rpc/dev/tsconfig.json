{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ESNext", "DOM", "WebWorker"],
    "module": "esnext",
    "declaration": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".", "../src"]
}
